LOG_LEVEL=INFO
VITE_API_URL=/api
# Comma-separated chain nodes. Requests go to the fastest healthy node; a node
# that errors is skipped for a while, and a node that has pruned the requested
# height hands the request to one that still has it.
INFERENCE_URLS=http://node2.gonka.ai:8000
# How often (seconds) to measure node latency and sync height.
RPC_PROBE_INTERVAL=30
# Last resort when every node above is down: borrow participant nodes from the
# current epoch. Off by default because they are third-party and their answers
# get cached permanently.
RPC_PARTICIPANT_FALLBACK=false
CACHE_DB_PATH=cache/cache.db

HTTPS_PORT=443

POLL_CURRENT_EPOCH_INTERVAL=30
POLL_JAIL_STATUS_INTERVAL=120
POLL_NODE_HEALTH_INTERVAL=60
POLL_REWARDS_INTERVAL=60
POLL_WARM_KEYS_INTERVAL=300
POLL_WARM_KEYS_BATCH_SIZE=10
POLL_HARDWARE_NODES_INTERVAL=600
POLL_HARDWARE_NODES_BATCH_SIZE=10
POLL_EPOCH_TOTAL_REWARDS_INTERVAL=600
POLL_PARTICIPANT_INFERENCES_INTERVAL=1200
POLL_MODELS_API_INTERVAL=300
POLL_TIMELINE_INTERVAL=30
POLL_CONFIRMATION_DATA_INTERVAL=1200

# Inference stats sourced from the gonka.gg public API.
# Their soft limit is ~10 req/min; the intervals below total ~1.4 req/min.
GONKA_GG_API_BASE=https://gonka-backend-production.up.railway.app/api/public
GONKA_GG_API_KEY=
POLL_INF_RECENT_INTERVAL=60
POLL_INF_GATEWAYS_INTERVAL=60
POLL_INF_TOP_MODELS_INTERVAL=120
POLL_INF_TIMESERIES_INTERVAL=300
POLL_INF_EPOCH_HISTORY_INTERVAL=300

